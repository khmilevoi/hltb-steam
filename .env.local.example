# Steam - get from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# NextAuth - generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Upstash Redis (KV) - populated by Vercel integration; used in production only
# Locally, the fs-driver cache (.cache/) is used instead
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
